{
  "name": "starter-vue3",
  "type": "module",
  "version": "0.0.5",
  "packageManager": "pnpm@9.15.9",
  "description": "Vue3 + Vite starter template with TypeScript, Pinia, Vue Router, i18n, UnoCSS, ESLint, and more.",
  "license": "MIT",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "browserslist": [
    "Chrome >= 89",
    "Firefox >= 84",
    "Safari >= 14",
    "Edge >= 89"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --fix",
    "release": "bumpp && npm publish"
  },
  "dependencies": {
    "lodash-es": "^4.17.23",
    "ofetch": "^1.5.1",
    "pinia": "^3.0.4",
    "vue": "^3.5.27",
    "vue-i18n": "^11.2.8",
    "vue-router": "^5.0.0-beta.2"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^7.2.0",
    "@intlify/unplugin-vue-i18n": "^11.0.3",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vitejs/plugin-vue-jsx": "^5.1.3",
    "bumpp": "^10.4.0",
    "eslint": "^9.39.2",
    "lint-staged": "^16.2.7",
    "simple-git-hooks": "^2.13.1",
    "unocss": "^66.6.0",
    "unplugin-env": "^1.0.5",
    "vite": "^7.3.1"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*": "eslint . --fix"
  }
}
