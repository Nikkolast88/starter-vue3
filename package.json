{
  "name": "starter-vue3",
  "type": "module",
  "version": "0.0.5",
  "packageManager": "pnpm@9.15.9",
  "description": "Vue3 + Vite starter template with TypeScript, Pinia, Vue Router, i18n, UnoCSS, ESLint, and more.",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "browserslist": [
    "Chrome >= 89",
    "Firefox >= 84",
    "Safari >= 14",
    "Edge >= 89"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --fix",
    "release": "bumpp && npm publish"
  },
  "dependencies": {
    "lodash": "^4.17.21",
    "ofetch": "^1.5.1",
    "pinia": "^3.0.3",
    "vue": "^3.5.22",
    "vue-i18n": "^11.1.12",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^6.2.0",
    "@intlify/unplugin-vue-i18n": "^11.0.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitejs/plugin-vue-jsx": "^5.1.1",
    "bumpp": "^10.3.1",
    "eslint": "^9.39.1",
    "lint-staged": "^16.2.6",
    "simple-git-hooks": "^2.13.1",
    "unocss": "^66.5.4",
    "unplugin-env": "^1.0.2",
    "vite": "^7.1.12"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*": "eslint . --fix"
  }
}
